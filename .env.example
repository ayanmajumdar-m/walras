# Walras Cloud server configuration. Copy to .env and fill in.
# Every variable the server reads is listed here; leave a value empty to
# turn that integration off. Never commit the real .env.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# true = the monthly billing, renewal and suspension jobs don't run
# (for local and staging copies that share data with production).
DISABLE_BILLING=false

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# One connection URL (config/dbConfig.js). PG_DATABASE_URL and POSTGRES_URL
# are accepted too.
DATABASE_URL=postgres://user:password@host:5432/walras
# Or the parts, when DATABASE_URL is not set (MYSQL_DB_* names also work).
PG_DB_HOST=
PG_DB_PORT=5432
PG_DB_USER=
PG_DB_PASSWORD=
PG_DB_NAME=
# false = no TLS (a local database). Otherwise TLS is used without checking
# the certificate chain, unless PG_SSL_STRICT=true.
PG_SSL=
PG_SSL_STRICT=false
PG_POOL_MAX=10

# ── Sessions and secrets ──────────────────────────────────────────────────
# Signs customer and admin sessions. Long and random; changing it signs
# everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Optional: 32 bytes (base64 or 64 hex characters) for encrypting saved
# secrets. Derived from JWT_SECRET when unset. Changing it makes secrets
# saved in admin unreadable.
SETTINGS_ENCRYPTION_KEY=

# ── Site ──────────────────────────────────────────────────────────────────
# Public address, used for links in emails and support tickets.
CLIENT_URL=https://www.walras.net

# ── Email ─────────────────────────────────────────────────────────────────
# Brevo's email API is used when BREVO_API_KEY is set; otherwise SMTP.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Default sender (Admin → Settings → Email sender overrides it). The address
# must be on a domain verified with the email provider.
MAIL_FROM_NAME=Walras Cloud
MAIL_FROM_ADDR=noreply@walras.net
# true (outside production only) = log emails instead of sending them.
MAIL_DEV_LOG=false

# ── Support tickets (Zendesk, OAuth client credentials) ───────────────────
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Optional: only tickets of this brand are shown to customers.
ZENDESK_BRAND_ID=

# ── Payments (Razorpay) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# enabled = auto top-up with saved cards, once Razorpay has turned on
# recurring payments for the account.
RAZORPAY_RECURRING=

# ── Domains (OpenProvider, WhoisXML) ──────────────────────────────────────
OPENPROVIDER_API=https://api.openprovider.eu/v1beta
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_INTERNAL_URL=
WHOIS_API_KEY=
